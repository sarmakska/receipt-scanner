# Anthropic API key with vision access (required)
ANTHROPIC_API_KEY=sk-ant-...

# Optional model and image overrides
VISION_MODEL=claude-opus-4-7
MAX_IMAGE_PX=2576

# Cloudflare R2 original-image storage (optional)
# Leave these unset to run without object storage; scanning still works.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
